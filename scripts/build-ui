    exampleBody: { tool: "calculate", params: { expr: "6 * 7" } },
  },
  "POST /v1/tools/summarize": {
    group: "tools",
    desc: "extractive summary of pasted text (local, no network)",
    exampleBody: { text: "The lab runs a deterministic router. Every request is parsed, classified by task, gated on VRAM, sent to the chosen model, answered, and logged for evals." },
  },
  "POST /v1/tools/search": {
    group: "tools",
    desc: "keyword search over stored notes (FTS5)",
    exampleBody: { query: "pipeline" },
  },
  "POST /v1/tools/calculate": {
    group: "tools",
    desc: "safe arithmetic evaluator",
    exampleBody: { expr: "2 + 3 * 4" },
  },

  "GET /v1/traces/export": {
    group: "traces",
    desc: "export recorded traces (format=sft|jsonl, limit) — fuel for the fine-tune flywheel",
    examplePath: "/v1/traces/export?format=sft&limit=5",
  },
  "POST /v1/traces/": {
    group: "traces",
    desc: "attach human feedback to a completed trace (up/down + note)",
    display: "/v1/traces/{id}/feedback",
    examplePath: "/v1/traces/PASTE_TRACE_ID/feedback",
    exampleBody: { feedback: "up", note: "from the api console" },
  },
};

const GROUP_ORDER = ["live", "ops", "chat", "memory", "control", "tools", "traces"];
const GROUP_TITLES = {
  live: "Live feed & UI",
  ops: "Operations",
  chat: "Chat, embeddings & compaction",
  memory: "Memory bank",
  control: "Control plane",
  tools: "Tool registry",
  traces: "Traces & evals",
};

function groupOf(p) {
  if (p.startsWith("/v1/chat")) return "chat";
  if (p === "/v1/embeddings" || p === "/v1/compact") return "chat";
  if (p.startsWith("/v1/memory")) return "memory";
  if (p.startsWith("/v1/control")) return "control";
  if (p.startsWith("/v1/tools")) return "tools";
  if (p.startsWith("/v1/traces")) return "traces";
  if (p === "/health" || p === "/metrics" || p === "/v1/models") return "ops";
  return "live";
}

function buildCatalog() {
  const routes = parseRoutes();
  const problems = [];
  const rows = [];

  for (const r of routes) {
    const key = `${r.method} ${r.path}`;
    const meta = META[key];
    if (!meta) { problems.push(`server route without docs: ${key}`); continue; }
    rows.push({
      method: r.method,
      path: meta.display || r.path,
      group: meta.group || groupOf(r.path),
      desc: meta.desc,
      kind: meta.kind || "http",
      examplePath: meta.examplePath || r.path,
      exampleBody: meta.exampleBody === undefined ? null : meta.exampleBody,
    });
  }

  /* stale docs = META entries for routes that no longer exist */
  for (const key of Object.keys(META)) {
    if (!routes.some((r) => `${r.method} ${r.path}` === key)) {
      problems.push(`docs for a route that no longer exists: ${key}`);
    }
  }

  if (problems.length) {
    console.error("catalog drift detected:");
    for (const p of problems) console.error("  ✗ " + p);
    process.exit(1);
  }

  const groups = GROUP_ORDER.map((id) => ({
    id,
    title: GROUP_TITLES[id],
    routes: rows.filter((r) => r.group === id),
  })).filter((g) => g.routes.length);

  return {
    source: "loco/server.py (parsed by scripts/build-ui)",
    count: rows.length,
    groups,
  };
}

/* ------------------------------------------------------------- run ------ */
function main() {
  console.log("build-ui: compiling ui/ts → ui/*.js");
  for (const line of compileTs()) console.log("  ✓ " + line);

  console.log("build-ui: generating ui/endpoints.json from loco/server.py");
  const catalog = buildCatalog();
  fs.writeFileSync(path.join(UI_DIR, "endpoints.json"), JSON.stringify(catalog, null, 1) + "\n");
  console.log(`  ✓ ${catalog.count} routes across ${catalog.groups.length} groups`);

  console.log("build-ui: ok");
}

main();
