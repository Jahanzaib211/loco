#!/usr/bin/env -S node --no-warnings
/* ============================================================================
   scripts/build-ui — zero-dependency UI build for Loco.
     1. compiles ui/ts/*.ts → ui/*.js (classic scripts) using Node's built-in
        type stripper (no npm, no bundler, no tsc)
     2. generates ui/endpoints.json by parsing the real route dispatch in
        loco/server.py — the API catalog can never drift from the server
     3. syntax-checks every emitted script (vm.Script) so a broken build
        fails here, not in the browser
   Run: node scripts/build-ui   (or: ./scripts/build-ui)
   ========================================================================== */
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const vm = require("node:vm");
const { stripTypeScriptTypes } = require("node:module");

// Node prints an ExperimentalWarning for stripTypeScriptTypes; harmless here.
process.removeAllListeners("warning");

const ROOT = path.resolve(__dirname, "..");
const TS_DIR = path.join(ROOT, "ui", "ts");
const UI_DIR = path.join(ROOT, "ui");
const SERVER = path.join(ROOT, "loco", "server.py");

/* -------------------------------------------------------------- 1) TS --- */
function compileTs() {
  if (!fs.existsSync(TS_DIR)) throw new Error("ui/ts/ not found");
  const files = fs.readdirSync(TS_DIR).filter((f) => f.endsWith(".ts")).sort();
  if (!files.length) throw new Error("ui/ts/ is empty — nothing to build");
  const out = [];
  for (const f of files) {
    const src = fs.readFileSync(path.join(TS_DIR, f), "utf8");
    let js;
    try {
      js = stripTypeScriptTypes(src, { mode: "strip", sourceUrl: f });
    } catch (e) {
      throw new Error(`strip failed for ui/ts/${f}: ${e.message}`);
    }
    const dest = path.join(UI_DIR, f.replace(/\.ts$/, ".js"));
    fs.writeFileSync(dest, js);
    try {
      new vm.Script(js, { filename: dest });   // parse-only syntax check
    } catch (e) {
      throw new Error(`syntax error in ${dest}: ${e.message}`);
    }
    out.push(`${f} → ${path.basename(dest)} (${js.length} B)`);
  }
  return out;
}

/* --------------------------------------------------- 2) route catalog --- */
/** Slice one method body out of server.py (class-level `def` at 4 spaces). */
function methodBody(src, name) {
  const i = src.indexOf(`    def ${name}(`);
  if (i < 0) throw new Error(`cannot find def ${name}() in loco/server.py`);
  const j = src.indexOf("\n    def ", i + 1);
  return src.slice(i, j < 0 ? src.length : j);
}

function collect(src, re, body, method, into) {
  let m;
  while ((m = re.exec(body)) !== null) {
    const p = m[1];
    if (p.includes("f\"") || p.includes("${")) continue;   // dynamic paths
    into.set(`${method} ${p}`, { method, path: p });
  }
}

function parseRoutes() {
  const src = fs.readFileSync(SERVER, "utf8");
  const routes = new Map();

  const get = methodBody(src, "do_GET");
  collect(get, /self\.path == "([^"]+)"/g, get, "GET", routes);
  collect(get, /self\.path\.startswith\("([^"]+)"\)/g, get, "GET", routes);
  // clause form: `self.path in ("/", "/ui", "/ui/")` — expand every quoted path
  {
    const re = /self\.path in \(([^)]*)\)/g;
    let m;
    while ((m = re.exec(get)) !== null) {
      for (const q of m[1].matchAll(/"([^"]+)"/g)) {
        routes.set(`GET ${q[1]}`, { method: "GET", path: q[1] });
      }
    }
  }

  const post = methodBody(src, "do_POST");
  collect(post, /(?<![.\w])path == "([^"]+)"/g, post, "POST", routes);
  collect(post, /(?<![.\w])path\.startswith\("([^"]+)"\)/g, post, "POST", routes);

  /* static-asset serving collapses into one honest entry */
  for (const key of [...routes.keys()]) {
    if (key.startsWith("GET /ui")) {
      routes.delete(key);
      routes.set("GET /ui/*", { method: "GET", path: "/ui/*" });
    }
  }
  return [...routes.values()];
}

/* Documentation + safe try-it examples. Key = "METHOD /path".
   Every route parsed from server.py MUST appear here — the build fails
   otherwise, which is what keeps the catalog honest. */
const META = {
  "GET /": { group: "live", desc: "lab overview page (the live 3D scene)", display: "/" },
  "GET /ui/*": { group: "live", desc: "static lab UI: pages, styles, scripts, endpoint catalog, identity docs" },
  "GET /ws": { group: "live", desc: "websocket feed — gpu snapshot (1s) + route/memory/control events", kind: "ws" },

  "GET /health": { group: "ops", desc: "liveness, uptime, gpu snapshot, component states (vector index, backends)" },
  "GET /metrics": { group: "ops", desc: "counters + gauges: routes, cache hits, evictions, memory notes, ws clients" },
  "GET /v1/models": { group: "ops", desc: "every brain this endpoint will serve (ids, aliases, context sizes)" },

  "POST /v1/chat/completions": {
    group: "chat",
    desc: "the one chat entry point — model id or loco:auto, optional tools, SSE stream",
    exampleBody: {
      model: "loco:auto",
      messages: [
        { role: "system", content: "You are Loco, a precise local lab assistant." },
        { role: "user", content: "Reply with exactly: loco ok" },
      ],
      temperature: 0, max_tokens: 64, stream: false,
    },
  },
  "POST /v1/compact": {
    group: "chat",
    desc: "long conversation → dense MEMORY BRIEF (keeps system + pinned + last N turns)",
    exampleBody: {
      messages: [
        { role: "system", content: "You are Loco." },
        { role: "user", content: "hello" },
        { role: "assistant", content: "hi" },
        { role: "user", content: "tell me about the lab" },
        { role: "assistant", content: "the lab runs local models" },
        { role: "user", content: "and the pipeline?" },
        { role: "assistant", content: "parse → classify → gate → backend" },
      ],
      keep_last: 2,
    },
  },
  "POST /v1/embeddings": {
    group: "chat",
    desc: "384-dim vectors — the same math that powers memory search and the semantic cache",
    exampleBody: { input: "propelled by local GPUs, nothing leaves the lab" },
  },

  "POST /v1/memory/add": {
    group: "memory",
    desc: "write an atomic note directly (importance, pinned flag) — bypasses the approval queue",
    exampleBody: { content: "console example: direct memory write", importance: 0.3, pinned: false, source: "ui" },
  },
  "POST /v1/memory/search": {
    group: "memory",
    desc: "hybrid recall: cosine over 384-dim embeddings + FTS5 keyword, fused and scored",
    exampleBody: { query: "pipeline", k: 5 },
  },
  "POST /v1/memory/propose": {
    group: "memory",
    desc: "queue a note for human approval — nothing durable is written silently",
    exampleBody: { content: "console example proposal: reviewed before it becomes memory", source: "ui" },
  },
  "GET /v1/memory/proposals": {
    group: "memory",
    desc: "list approval queue (status=pending|approved|rejected, limit)",
    examplePath: "/v1/memory/proposals?status=pending&limit=10",
  },
  "POST /v1/memory/proposals": {
    group: "memory",
    desc: "alias of POST /v1/memory/propose",
    exampleBody: { content: "console example proposal via alias", source: "ui" },
  },
  "POST /v1/memory/proposals/": {
    group: "memory",
    desc: "resolve a queued proposal — approve (writes the note) or reject",
    display: "/v1/memory/proposals/{id}/approve | reject",
    examplePath: "/v1/memory/proposals/PASTE_ID/approve",
    exampleBody: {},
  },
  "POST /v1/memory/reinforce": {
    group: "memory",
    desc: "boost the scores of notes that proved useful (ids from a search result)",
    exampleBody: { ids: [] },
  },
  "POST /v1/memory/stats": {
    group: "memory",
    desc: "notes, pinned, cache rows/hits, pending proposals, index state",
    exampleBody: {},
  },
  "POST /v1/memory/index/rebuild": {
    group: "memory",
    desc: "rebuild the ready-cache vector index from stored embeddings",
    exampleBody: {},
  },

  "GET /v1/control/status": {
    group: "control",
    desc: "resident models per backend, presets active flag, load/unload state",
  },
  "GET /v1/control/config": {
    group: "control",
    desc: "per-model runtime flags (ctx-size, kv cache type, gpu layers, …) + flag docs",
  },
